# Copiar para .env e preencher. O .env nunca vai para o git.

# Túnel Cloudflare `siac` (ver TUNNEL.md)
CLOUDFLARE_TUNNEL_TOKEN=

# PostgreSQL (superuser da instância; roles por serviço criados em postgres/init/)
POSTGRES_DB=siac
POSTGRES_USER=siac_admin
POSTGRES_PASSWORD=

# Passwords dos roles por serviço (usadas pelo init e pelos serviços)
SIAC_AUTH_DB_PASSWORD=
SIAC_CORE_DB_PASSWORD=

# siac-auth
SIAC_ADMIN_INITIAL_EMAIL=admin@siasc.pt
SIAC_ADMIN_INITIAL_PASSWORD=
